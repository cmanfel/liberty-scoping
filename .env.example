NEXT_PUBLIC_SITE_URL=https://libertyscoping.com
# Leave blank until the customer portal is deployed; Login / Get Started then fall back to the contact page.
NEXT_PUBLIC_PORTAL_URL=

# --- Contact inquiry system (server-only; see docs/inquiry-system.md) ---
# Existing Stenofy Firebase project that holds the libertyScoping* collections.
FIREBASE_PROJECT_ID=stenofy-4e684
# Vercel OIDC -> Google Workload Identity Federation (no JSON key).
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
# Delivery.
INQUIRY_BUSINESS_EMAIL=
INQUIRY_FROM_EMAIL=contact@libertyscoping.com
# "resend" in production. "mock" is for local use only (refused on Vercel production).
INQUIRY_MAIL_PROVIDER=
# Resend API key (sending access, scoped to libertyscoping.com). Secret, server-only.
INQUIRY_MAIL_API_KEY=
# Random secret used when hashing IPs / idempotency keys / rate-limit subjects.
INQUIRY_HASH_SALT=
# Optional: enables POST /api/inquiries/retry (Authorization: Bearer <token>).
INQUIRY_RETRY_TOKEN=
# Local development against the Firestore emulator only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
